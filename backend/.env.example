# Copier ce fichier en `.env` et adapter les valeurs.
# Toutes ces variables peuvent aussi être définies directement comme
# variables d'environnement (ex: dans docker-compose ou le déploiement).

# URL de base de l'instance Celcat (sans slash final), utilisée si le
# paramètre `base_url` n'est pas fourni dans l'URL d'appel.
CELCAT_BASE_URL=https://celcat.u-bordeaux.fr/calendar

# Cookie de session Celcat par défaut (récupéré manuellement depuis un
# navigateur après connexion SSO, cf. README.md). Permet d'exposer une URL
# de calendrier "prête à l'emploi" sans avoir à transmettre le cookie à
# chaque appel. Peut être surchargé par le paramètre `cookie` dans l'URL.
CELCAT_COOKIE=

# Groupe (federation id) par défaut si le paramètre `group` n'est pas
# fourni dans l'URL, ex: "M1 CMI OSIA parcours OPTIM".
CELCAT_DEFAULT_GROUP=

# Nombre de jours par défaut couverts si `start`/`end` ne sont pas fournis
# dans l'URL (fenêtre = [start, start + DEFAULT_RANGE_DAYS]).
DEFAULT_RANGE_DAYS=90

# Pause (en secondes) entre deux requêtes semaine par semaine vers Celcat.
REQUEST_SLEEP_SECONDS=0.4

# Timeout HTTP (en secondes) pour chaque requête vers Celcat.
REQUEST_TIMEOUT_SECONDS=20

# Durée de vie du cache en mémoire (en secondes). 0 pour désactiver.
CACHE_TTL_SECONDS=300

# Origines autorisées pour CORS, séparées par des virgules. "*" pour tout autoriser.
CORS_ORIGINS=*
